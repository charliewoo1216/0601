# 개인 AI Agent 플랫폼 (OpenClaw 기반) — 비밀값 전용
# 실제 값을 채운 뒤 `.env`로 복사해서 사용 (이 파일 자체는 값 없이 git에 커밋)
#
# 각 값을 어디서 구하는지는 PLAN.md "Phase 0" 참고.

# ── Gateway 인증 토큰 (openssl rand -hex 32 로 생성) ──────────
OPENCLAW_GATEWAY_TOKEN=

# ── Telegram 봇 4개 (BotFather에서 각각 발급) ──────────────────
TELEGRAM_BOT_TOKEN_CODING=
TELEGRAM_BOT_TOKEN_ANALYSIS=
TELEGRAM_BOT_TOKEN_WEB=
TELEGRAM_BOT_TOKEN_SERVER=

# ── 본인 Telegram 사용자 ID (숫자) ──────────────────────────────
# 4개 봇 모두 이 ID만 허용(allowlist)하도록 openclaw.json에서 참조한다.
# 확인 방법: 아무 텔레그램 봇(@userinfobot 등)에게 말을 걸면 알려줌.
TELEGRAM_OWNER_ID=

# ── Claude Max (CLI backend) ───────────────────────────────────
# API 키 불필요. 서버에서 `claude login` 을 먼저 실행해 세션을 만들어두면
# OpenClaw의 anthropic 확장(claude-cli backend)이 그 세션을 그대로 사용한다.

# ── OpenRouter ──────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── OpenAI API ────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Ollama (기존에 이미 구동 중인 서버, 이 프로젝트가 설치하지 않음) ──
OLLAMA_BASE_URL=http://<ollama-host>:11434
